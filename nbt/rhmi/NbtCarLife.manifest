<?xml version="1.0" encoding="utf-8"?>
<plugin>
  <name>NbtCarLife</name>
  <type>App</type>
  <file>{pluginDir}/NbtCarLife</file>
  <config>
    <autoStart>yes</autoStart>
    <dependencies>
      <pluginAppConnector>
        <type>Etch</type>
        <id>210</id>
        <asyncCallbacks>yes</asyncCallbacks>
      </pluginAppConnector>
    </dependencies>
    <parameters>
      <DescFile>{pluginDir}/NbtCarLife.xml</DescFile>
      <TextDBFile>{pluginDir}/NbtCarLife_ALL_Texts.zip</TextDBFile>
      <ImageDBFile>{pluginDir}/NbtCarLife_ALL_Images.zip</ImageDBFile>
    </parameters>
  </config>
</plugin>
